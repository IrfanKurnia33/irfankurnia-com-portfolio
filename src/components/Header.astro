---
import { site } from '../data/site';
const { current = '' } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Irfan Kurnia — Home">
      <img src="/images/brand.svg" width="37" height="48" alt="" />
    </a>
    <nav class="header-links" aria-label="Main navigation">
      {site.links.resume ? (
        <a href={site.links.resume} target="_blank" rel="noopener noreferrer">
          Resume<span class="sr-only"> (opens in a new tab)</span>
        </a>
      ) : (
        <span class="unavailable" aria-label="Resume — coming soon">
          Resume <span class="coming-soon">soon</span>
        </span>
      )}
      <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn<span class="sr-only"> (opens in a new tab)</span>
      </a>
      <a
        href="/now/"
        class:list={[{ 'is-current': current === 'now' }]}
        aria-current={current === 'now' ? 'page' : undefined}
      >
        Now
      </a>
    </nav>
    <button
      class="mobile-menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <svg
        class="menu-icon"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path class="menu-line menu-line-top" d="M4 7H20" />
        <path class="menu-line menu-line-middle" d="M4 12H20" />
        <path class="menu-line menu-line-bottom" d="M4 17H20" />
      </svg>
    </button>
  </div>
  <nav id="mobile-navigation" class="mobile-navigation" aria-label="Mobile navigation" inert>
    <a href="/#hero">Home</a>
    {site.links.resume ? (
      <a href={site.links.resume} target="_blank" rel="noopener noreferrer">
        Resume<span class="sr-only"> (opens in a new tab)</span>
      </a>
    ) : (
      <span class="unavailable">
        Resume <small>Coming soon</small>
      </span>
    )}
    <a href={site.links.linkedin} target="_blank" rel="noopener noreferrer">
      LinkedIn ↗<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a href="/now/" aria-current={current === 'now' ? 'page' : undefined}>
      Now
    </a>
  </nav>
</header>
<noscript>
  <nav class="no-script-nav" aria-label="Additional navigation">
    <a href="/now/">Now</a>
    <a href={site.links.linkedin}>LinkedIn</a>
  </nav>
</noscript>
