---
import '@fontsource-variable/sora';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/hanken-grotesk/wght-italic.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '@fontsource/gloria-hallelujah/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/Dock.astro';
import SpaceBackground from '../components/SpaceBackground.astro';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  page?: 'home' | 'now' | 'work' | '404';
}
const { title = site.title, description = site.description, page = 'home' } = Astro.props;
---

<!doctype html>
<html lang="en" data-page={page} data-section={page === 'home' ? 'hero' : page}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAFEF5" />
    {site.preview && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://irfankurnia.com/social-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Irfan Kurnia — designing for complex and regulated products"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      const root = document.documentElement;
      const prefersReducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      root.dataset.motion = prefersReducedMotion ? 'paused' : 'running';
      try {
        root.dataset.motion =
          prefersReducedMotion || localStorage.getItem('portfolio-motion') === 'paused'
            ? 'paused'
            : 'running';
      } catch {
        /* Storage is optional; the site works without it. */
      }
      if (root.dataset.motion === 'running') root.dataset.pageEnter = 'true';
      try {
        if (
          root.dataset.page === 'home' &&
          !location.hash &&
          !sessionStorage.getItem('portfolio-intro') &&
          !prefersReducedMotion &&
          root.dataset.motion !== 'paused'
        )
          root.dataset.intro = 'enter';
        if (root.dataset.page === 'home') sessionStorage.setItem('portfolio-intro', 'seen');
      } catch {
        /* Storage is optional; the site works without it. */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SpaceBackground />
    <Header current={page} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {page === 'home' && <Dock />}
    <button
      class="motion-toggle"
      type="button"
      aria-pressed="false"
      aria-label="Pause site animations"
    >
      <span class="motion-toggle-symbol" aria-hidden="true">
        Ⅱ
      </span>
      <span class="motion-toggle-label">Pause motion</span>
    </button>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
