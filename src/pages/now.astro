---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import CardStack from '../components/CardStack.astro';
import ContactCards from '../components/ContactCards.astro';
import { site, formatDate } from '../data/site';
const entry = await getEntry('now', 'update');
if (!entry) throw new Error('Now content is missing.');
const { Content } = await render(entry);
---

<Base
  page="now"
  title="Now — Irfan Kurnia"
  description="What Irfan Kurnia is up to these days: work, life, and small moments in Jakarta."
>
  <section class="now-page container">
    <div class="now-heading">
      <h1>
        What I’m up to <strong>these days</strong>
      </h1>
      <p>
        Last updated: <time datetime={entry.data.updated}>{formatDate(entry.data.updated)}</time>
      </p>
    </div>
    <div class="now-grid">
      <div class="now-copy prose">
        <Content />
      </div>
      <div class="now-gallery">
        <CardStack variant="gallery" />
        <a class="primary-button" href={site.links.blog} target="_blank" rel="noopener noreferrer">
          Check out my personal blog <span aria-hidden="true">→</span>
          <span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
    <ContactCards />
  </section>
</Base>
